#!/bin/sh
# Starts ad-mute at boot and restarts it if it ever exits.
PIDFILE=/var/run/ad-mute.pid
LOG=/tmp/ad-mute.log
. /etc/ad-mute.conf

start() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null && { echo "already running"; return; }
    echo "Starting ad-mute"
    # The loop uses the log, not the terminal, so an SSH session can end while it runs.
    (
        trap 'kill $child 2>/dev/null; wait $child; exit 0' TERM INT
        while true; do
            /usr/bin/ad-mute -target "$ONN_TARGET" -package "$PACKAGE" >>"$LOG" 2>&1 &
            child=$!
            wait $child
            sleep 5
        done
    ) </dev/null >>"$LOG" 2>&1 &
    echo $! > "$PIDFILE"
}

stop() {
    echo "Stopping ad-mute"
    [ -f "$PIDFILE" ] && kill "$(cat $PIDFILE)" 2>/dev/null
    rm -f "$PIDFILE"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
